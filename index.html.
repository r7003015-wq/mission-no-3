<script>
const questionData = [
[
["Do you officially accept the position of the Queen's Bewakoof Best Friend?","Excellent! The Queen approves. 👑","Excuse me? The Queen needs an explanation."],
["Will you tolerate the Queen's unlimited bakwaas without complaining?","That's the spirit!","Your application is under reconsideration."],
["Will you give the Queen your daily updates after 11 PM?","Your attendance is appreciated.","The Queen would like to have a word with you."],
["Will you stay even when the Queen is being extra dramatic?","A loyal subject indeed!","Hmm, interesting choice..."],
["Do you promise not to replace the Queen with another best friend?","The Queen is pleased.","Security, please check this answer! 😭"],
["Are you ready for a lifetime of friendship, madness and unlimited nonsense?","WELCOME TO THE ROYAL FAMILY! ❤️","There is no exit door, Your Highness."]
],
[
["Sometimes, during a fight, the Queen might say something in anger. Will you tell her honestly if she hurts you instead of keeping it to yourself?","Good! The Queen appreciates honest complaints.","Who gave you permission to keep everything to yourself?"],
["Will you tell the Queen whenever something is bothering you, whether it's about your life or anything happening around you?","Excellent! Daily gossip and life updates are officially encouraged.","Then what's the point of having a royal best friend?"],
["The Queen isn't perfect and sometimes messes things up. Will you handle all the troubles she made?","Loyal subject detected!","The Queen would like to reconsider your application."],
["The Queen is a little complicated and sometimes difficult to understand. Knowing that, will you still accept this opportunity?","Brave decision. You have been warned!","Unfortunately, the Queen doesn't have a replacement ready."]
]
];

function makeQuestions(){
 questionData.forEach((group,g)=>{
  const container=document.getElementById(g===0?"questions1":"questions2");
  group.forEach((q,i)=>{
   const number=g===0?i+1:i+7;
   const div=document.createElement("div");
   div.className="question";
   div.innerHTML=`
    <p><b>${number}. ${q[0]}</b></p>
    <button onclick="answer(${number},true)">YES ✨</button>
    <button class="back" onclick="answer(${number},false)">NO 🙈</button>
    <div class="answer" id="answer${number}"></div>`;
   container.appendChild(div);
  });
 });
}

function answer(number,yes){
 const g=number<=6?0:1;
 const index=number<=6?number-1:number-7;
 const message=questionData[g][index][yes?1:2];
 document.getElementById("answer"+number).textContent=message;
 if(yes) sparkleBurst(25);
}

function showPage(number){
 document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
 document.getElementById("page"+number).classList.add("active");
 window.scrollTo(0,0);
 if(number===6) sparkleBurst(45);
 if(number===7) makeFloatingStars();
}

function openGift(number){
 document.querySelectorAll(".gift-content").forEach(g=>g.classList.remove("show"));
 document.getElementById("gift"+number).classList.add("show");
 sparkleBurst(35);
}

function sparkleBurst(amount){
 const symbols=["✦","✧","✨","⭐","💫"];
 for(let i=0;i<amount;i++){
  const star=document.createElement("span");
  star.className="magic-spark";
  star.textContent=symbols[Math.floor(Math.random()*symbols.length)];
  star.style.left=(Math.random()*100)+"vw";
  star.style.top=(Math.random()*75+10)+"vh";
  star.style.setProperty("--dx",(Math.random()*300-150)+"px");
  star.style.setProperty("--dy",(Math.random()*300-150)+"px");
  document.body.appendChild(star);
  setTimeout(()=>star.remove(),1600);
 }
}

let starsMade=false;
function makeFloatingStars(){
 if(starsMade)return;
 starsMade=true;
 for(let i=0;i<22;i++){
  const star=document.createElement("span");
  star.className="floating-star";
  star.textContent="✧";
  star.style.left=Math.random()*100+"vw";
  star.style.top=Math.random()*100+"vh";
  star.style.fontSize=(12+Math.random()*20)+"px";
  star.style.animationDelay=Math.random()*4+"s";
  document.body.appendChild(star);
 }
}

makeQuestions();
</script>

