
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Royal Friendship Proposal | Bellshore 👑</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;background:#100d1c;color:#fff4df;
 font-family:Georgia,serif;text-align:center;
}
.page{
 display:none;min-height:100vh;padding:30px 16px;
 align-items:center;justify-content:center;flex-direction:column;
 background:linear-gradient(#130d25e8,#100d1de8),
 url("https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1600&q=80")
 center/cover fixed;overflow:hidden;
}
.page.active{display:flex}
h1{color:#f4d38a;font-size:clamp(30px,6vw,48px);text-shadow:0 0 15px #e9b95b66}
h2{color:#eecb85}
p{line-height:1.8}
button{
 background:#a87938;color:#fff8e8;border:1px solid #f1d49b;
 padding:13px 24px;border-radius:30px;font-size:16px;
 cursor:pointer;margin:10px;font-family:Georgia,serif;
 transition:.3s;
}
button:hover{background:#d09b4f;transform:scale(1.05)}
.card{
 width:min(750px,96%);background:#251b32ef;
 border:2px solid #c99d59;border-radius:16px;
 padding:25px;box-shadow:0 0 30px #0009;
}
.parchment{
 width:min(760px,96%);padding:35px 25px;
 color:#392515;
 background:linear-gradient(135deg,#ead3a2,#d8b77d,#f0dcae);
 border:12px ridge #986b39;
 box-shadow:0 15px 40px #000b,inset 0 0 35px #80532966;
 text-align:left;
}
.parchment h2{color:#653c1e;text-align:center}
.letter-text{white-space:pre-line;font-size:16px;line-height:1.9}
.seal{
 width:90px;height:90px;border-radius:50%;
 background:radial-gradient(circle at 30% 25%,#e36d59,#8e1518 65%,#4d080e);
 color:#ffe2a0;border:5px double #e8b86b;
 display:flex;align-items:center;justify-content:center;
 font-size:38px;margin:25px auto 0;
 box-shadow:0 0 20px #e9ad5266;transform:rotate(-10deg);
}
.owl{font-size:70px;animation:fly 3s ease-in-out}
@keyframes fly{
 0%{transform:translate(-40vw,-20vh) scale(.2);opacity:0}
 70%{transform:translate(0,0) scale(1.2);opacity:1}
 100%{transform:scale(1);opacity:1}
}
.question{
 text-align:left;background:#392a3e;padding:16px;
 margin:14px 0;border-radius:12px;border:1px solid #a9824f;
}
.question p{margin-top:0}
.answer{font-size:14px;color:#f4d38a;min-height:22px;margin-top:8px}
.gifts{
 display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));
 gap:15px;width:min(700px,95%);
}
.gift{
 background:#33233d;border:1px solid #d6ad6d;
 border-radius:15px;padding:25px 12px;cursor:pointer;
 font-size:19px;transition:.3s;
}
.gift:hover{background:#59405a;transform:translateY(-6px);box-shadow:0 0 20px #f6d68a55}
.gift-content{display:none;margin-top:25px}
.gift-content.show{display:block;animation:reveal 1s ease-out}
@keyframes reveal{
 0%{opacity:0;transform:scale(.75) translateY(20px)}
 70%{transform:scale(1.03)}
 100%{opacity:1;transform:scale(1)}
}
.magic-spark{
 position:fixed;z-index:99999;pointer-events:none;
 font-size:22px;color:#ffe59b;text-shadow:0 0 12px #ffd76a;
 animation:burst 1.5s ease-out forwards;
}
@keyframes burst{
 0%{opacity:0;transform:translate(0,0) scale(.2)}
 20%{opacity:1}
 100%{opacity:0;transform:translate(var(--dx),var(--dy)) scale(1.7) rotate(180deg)}
}
.floating-star{
 position:fixed;z-index:1;pointer-events:none;color:#ffe5a3;
 text-shadow:0 0 12px #ffd76a;animation:floatStar 4s ease-in-out infinite;
}
@keyframes floatStar{
 0%,100%{opacity:.15;transform:translateY(0) scale(.7)}
 50%{opacity:1;transform:translateY(-25px) scale(1.2)}
}
.small{font-size:13px;color:#e6cda5}
@media(max-width:500px){
 .parchment{padding:25px 17px}
 .letter-text{font-size:14px}
 .card{padding:18px}
}
</style>
</head>

